  m_Script: {fileID: 11500000, guid: 5a6728bf9f00b8143a5547e5c9f2270b, type: 3}
  m_Name: EndingTextBank
  m_EditorClassIdentifier: 
  goodEndingTexts:
  - "\uACB0\uAD6D\uC5D4 \uB2F9\uC2E0\uC774 \uC774\uACBC\uB124\uC694."
  - "\uB2F9\uC2E0\uC774 \uC9C0\uAE08\uAE4C\uC9C0 \uC0B4\uC544\uC788\uC744\uC904\uC740
    \uBAB0\uB790\uC5B4\uC694"
  - "\uC544 \uB9DE\uB2E4.\n\uB2F9\uC2E0\uC774 \uC774\uACBC\uC73C\uB2C8 \uC774\uC81C
    \uC774\uBC29\uC5D0\uC11C \uB098\uAC00\uAC8C \uD574\uB4DC\uB824\uC57C\uC8E0"
  - "\uC774\uACF3\uC740 \uBCF4\uC548\uC0C1\uC758 \uC774\uC720\uB85C\n\uB208\uC744
    \uB728\uACE0 \uB098\uAC00\uAC8C \uD560 \uC218\uC5C6\uC5B4\uC694"
  - "\uBC29\uC548\uC758 \uC778\uCCB4\uC5D0 \uBB34\uD574\uD55C \uC218\uBA74\uAC00\uC2A4\uB97C
    \uC0B4\uD3EC\uD560\uD14C\uB2C8\n\uB208\uC744 \uAC10\uACE0 \uD3B8\uC548\uD558\uAC8C
    \uC788\uC73C\uC2DC\uBA74 \uB429\uB2C8\uB2E4"
  - "\uC2B9\uB9AC\uB97C \uCD95\uD558\uB4DC\uB9BD\uB2C8\uB2E4.\n\uC2E4\uD5D8\uCCB4"
