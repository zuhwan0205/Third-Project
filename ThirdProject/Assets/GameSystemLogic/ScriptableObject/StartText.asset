  m_Script: {fileID: 11500000, guid: 8bb5c628e6c020f45a180996ec2867cc, type: 3}
  m_Name: StartText
  m_EditorClassIdentifier: 
  startTexts:
  - "\uC548\uB155\uD558\uC138\uC694\n\uB9CC\uB098\uC11C \uBC18\uAC11\uC2B5\uB2C8\uB2E4."
  - "\uB2F9\uC2E0\uC774 \uC65C \uC774\uBC29\uC5D0 \uC788\uB294\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uACE0\n\uC774
    \uBC29\uC5D0\uC11C \uB098\uAC00\uACE0 \uC2F6\uC73C\uC2DC\uC8E0??"
  - "\uD558\uC9C0\uB9CC \uC800\uB294 \uB2F9\uC2E0\uACFC \uAC8C\uC784\uC744 \uD558\uACE0\uC2F6\uC73C\uB2C8\n\uAC8C\uC784\uC744
    \uD1B5\uD574 \uC774\uAE30\uBA74 \uB2F9\uC2E0\uC744 \uAEBC\uB0B4\uB4DC\uB9AC\uC8E0"
  - "\uAC8C\uC784\uC758 \uADDC\uCE59\uC740 \uAC04\uB2E8\uD569\uB2C8\uB2E4.\n\uC800\uB294
    \uB2F9\uC2E0\uAED8 \uC9C8\uBB38\uC744 \uD560\uAC81\uB2C8\uB2E4."
  - "\uADF8\uB7FC \uB2F9\uC2E0\uC740 \uC9C8\uBB38\uC744 \uB4E3\uACE0\n\uC608, \uC544\uB2C8\uC624
    \uBC84\uD2BC\uB9CC \uB204\uB974\uBA74 \uB429\uB2C8\uB2E4."
  - "\uC9C8\uBB38\uB9C8\uB2E4 \uC2DC\uAC04\uC740 20\uCD08\uB97C \uB4DC\uB9BD\uB2C8\uB2E4.\n20\uCD08\uB97C
    \uB118\uAE34\uB2E4\uBA74 \uB2F9\uC2E0\uC758 \uD328\uBC30\uC785\uB2C8\uB2E4."
  - "\uD328\uBC30\uD558\uC2DC\uBA74 \uC5EC\uAE30\uC11C \uB098\uAC00\uC2E4 \uC218
    \uC5C6\uC5B4\uC694."
  - "\uC774\uD574\uD558\uC168\uC73C\uBA74 YES \uBC84\uD2BC\uC744 \uB20C\uB7EC\uC8FC\uC138\uC694."
